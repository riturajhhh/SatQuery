# ============================================================
# SatQuery AI — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# Do NOT commit .env to version control.
# ============================================================

# ---- Application ----
APP_NAME=SatQuery AI
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ---- Backend Server ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000

# ---- Database ----
DATABASE_URL=sqlite:///./satquery.db
# For PostgreSQL migration:
# DATABASE_URL=postgresql://user:password@localhost:5432/satquery

# ---- Storage Paths ----
UPLOAD_DIR=./uploads
PROCESSED_DIR=./outputs/processed
EVIDENCE_DIR=./outputs/evidence
REPORTS_DIR=./reports
MODELS_DIR=./models

# ---- Upload Limits ----
MAX_UPLOAD_SIZE_MB=500
ALLOWED_EXTENSIONS=.tif,.tiff,.geotiff,.png,.jpg,.jpeg

# ---- Model Configuration ----
# VQA Model
VQA_MODEL_NAME=blip2-rs-vqa
VQA_MODEL_PATH=./models/vqa/
VQA_DEVICE=auto
VQA_MAX_LENGTH=512

# Captioning Model
CAPTION_MODEL_NAME=blip2-rs-caption
CAPTION_MODEL_PATH=./models/captioning/
CAPTION_DEVICE=auto

# Grounding Model
GROUNDING_MODEL_NAME=rs-grounding
GROUNDING_MODEL_PATH=./models/grounding/
GROUNDING_DEVICE=auto

# Change Detection Model
CD_MODEL_NAME=bit-cd
CD_MODEL_PATH=./models/change_detection/
CD_DEVICE=auto
CD_THRESHOLD=0.5

# Change VQA Model
CDVQA_MODEL_NAME=cdvqa-model
CDVQA_MODEL_PATH=./models/change_vqa/
CDVQA_DEVICE=auto

# Optical-SAR Model
OPTSAR_MODEL_NAME=optical-sar-fusion
OPTSAR_MODEL_PATH=./models/optical_sar/
OPTSAR_DEVICE=auto

# ---- GPU Configuration ----
CUDA_VISIBLE_DEVICES=0
USE_GPU=true
GPU_MEMORY_FRACTION=0.8
# Set to 'cpu' to force CPU inference
DEVICE_OVERRIDE=

# ---- Inference Settings ----
DEFAULT_CONFIDENCE_THRESHOLD=0.5
MAX_IMAGE_DIMENSION=4096
TILE_SIZE=512
TILE_OVERLAP=64
BATCH_SIZE=1

# ---- Agent Configuration ----
AGENT_MAX_RETRIES=3
AGENT_TIMEOUT_SECONDS=300

# ---- API Keys (if needed for external services) ----
# HUGGINGFACE_TOKEN=
# OPENAI_API_KEY=

# ---- Dataset Paths ----
BIGEARTHNET_DIR=./datasets/bigearthnet_txt/
VRSBENCH_DIR=./datasets/vrsbench/
RSVQA_DIR=./datasets/rsvqa/
CDVQA_DIR=./datasets/cdvqa/
